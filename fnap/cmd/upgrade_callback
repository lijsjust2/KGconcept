#!/bin/bash

### This script is called after the application is upgraded.
### 升级后 token 可能轮换，重新持久化一次。

TOKEN_FILE="${TRIM_APPDEST}/.trim_token"

if [ -n "${TRIM_API_TOKEN}" ]; then
    echo "${TRIM_API_TOKEN}" > "${TOKEN_FILE}"
    chmod 600 "${TOKEN_FILE}" 2>/dev/null
    echo "[$(date)] upgrade_callback: TRIM_API_TOKEN 已写入 ${TOKEN_FILE} (长度: ${#TRIM_API_TOKEN})"
else
    echo "[$(date)] upgrade_callback: TRIM_API_TOKEN 为空，未写入"
fi

exit 0
