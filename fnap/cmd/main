#!/bin/bash

# KGconcept 应用运行控制脚本
# Docker 容器由飞牛 appcenter 通过 config/resource 的 docker-project 声明自动管理。
#
# 注意：appcenter 启动 docker-compose 时，不会把 TRIM_API_TOKEN 注入到容器环境里。
# 所以这里在 start/status 被调用时（飞牛会执行 cmd/main 脚本，并把 TRIM_API_TOKEN 作为 env 注入），
# 把 token 写入到应用安装目录下的 .trim_token 文件，
# 再由 docker-compose 把这个文件挂载进容器，最后容器的 entrypoint 读取文件设置环境变量。

APPDEST="${TRIM_APPDEST}"
TOKEN_FILE="${APPDEST}/.trim_token"

FILE_PATH="${APPDEST}/docker/docker-compose.yaml"

# 把 TRIM_API_TOKEN 写入应用目录下的文件（如果 env 里存在 token）
persist_trim_token() {
    if [ -n "${TRIM_API_TOKEN}" ]; then
        echo "${TRIM_API_TOKEN}" > "${TOKEN_FILE}"
        chmod 600 "${TOKEN_FILE}" 2>/dev/null
        echo "[$(date)] TRIM_API_TOKEN 已写入 ${TOKEN_FILE} (长度: ${#TRIM_API_TOKEN})"
    else
        echo "[$(date)] 警告: TRIM_API_TOKEN 环境变量为空，未写入 token 文件"
    fi
}

is_docker_running () {
    DOCKER_NAME=""

    if [ -f "$FILE_PATH" ]; then
        DOCKER_NAME=$(grep "container_name" "$FILE_PATH" | awk -F ':' '{print $2}' | xargs)
    fi

    if [ -n "$DOCKER_NAME" ]; then
        docker inspect "$DOCKER_NAME" 2>/dev/null | grep -q "\"Status\": \"running\"," && return 0
        return 1
    fi
    return 1
}

case $1 in
start)
    # 飞牛 appcenter 会自动启动 Docker 容器，这里只负责把 token 持久化
    persist_trim_token
    exit 0
    ;;
stop)
    # 飞牛 appcenter 会自动停止容器
    exit 0
    ;;
status)
    # status 被调用时也会带 token，确保文件被更新
    persist_trim_token

    # 通过 docker inspect 查容器状态
    if is_docker_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
