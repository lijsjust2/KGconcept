#!/bin/bash

# KGconcept 应用运行控制脚本
# 关键：飞牛通过 config/resource 的 docker-project 声明自动管理容器生命周期，
# cmd/main 只需用 docker ps 按容器名查询状态，不要依赖 docker compose project name
# （compose 文件里 container_name 固定为 kgconcept，跨 project 都能查到）

CONTAINER_NAME="kgconcept"
COMPOSE_DIR="$TRIM_APPDEST/app/docker"

# 判断容器是否处于 running 状态（按容器名精确匹配，不依赖 compose project）
is_running() {
  docker ps -f "name=^${CONTAINER_NAME}$" -f "status=running" --format '{{.Names}}' 2>/dev/null | grep -qx "$CONTAINER_NAME"
}

# 解析共享目录实际路径（软链 -> 真实路径），用于挂载到容器
SHARE_LINK="/var/apps/KGconcept/share/downloads"
DOWNLOAD_SHARE_PATH=$(readlink -f "$SHARE_LINK" 2>/dev/null || echo "$SHARE_LINK")
export DOWNLOAD_SHARE_PATH
export SERVICE_PORT="${TRIM_SERVICE_PORT:-8880}"

case "$1" in
  start)
    echo "启动 KGconcept..." > "$TRIM_TEMP_LOGFILE"

    # 容器已在运行则直接返回成功（避免重复启动导致端口占用）
    if is_running; then
      echo "KGconcept 容器已在运行，跳过启动" >> "$TRIM_TEMP_LOGFILE"
      exit 0
    fi

    # 容器未运行：兜底通过 compose 启动（飞牛通常已自动启动，这里是异常恢复路径）
    if [ -d "$COMPOSE_DIR" ]; then
      cd "$COMPOSE_DIR" || exit 1
      # 清理可能存在的同容器名残留（Exited 状态）
      docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
      docker compose -p kgconcept up -d 2>> "$TRIM_TEMP_LOGFILE" || {
        echo "docker compose 启动失败" >> "$TRIM_TEMP_LOGFILE"
        exit 1
      }
      exit 0
    fi

    echo "compose 目录不存在: $COMPOSE_DIR" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;

  stop)
    echo "停止 KGconcept..." > "$TRIM_TEMP_LOGFILE"
    # 按容器名停止，不依赖 compose project name
    docker stop "$CONTAINER_NAME" 2>> "$TRIM_TEMP_LOGFILE" || true
    docker rm -f "$CONTAINER_NAME" 2>> "$TRIM_TEMP_LOGFILE" || true
    exit 0
    ;;

  status)
    # 按容器名查运行状态，跨 compose project 都能找到
    if is_running; then
      exit 0
    fi
    exit 3
    ;;

  *)
    echo "未知命令: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
